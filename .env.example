# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# MapTiler Configuration
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key

# OpenRouteService Configuration
NEXT_PUBLIC_ORS_API_KEY=your_openrouteservice_api_key

# Groq API Configuration (Backend Only - Do Not Use in Frontend)
# GROQ_API_KEY=your_groq_api_key
# Note: Groq API key should only be used in backend API routes

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NeuroLens Guardian

# Feature Flags
NEXT_PUBLIC_ENABLE_AR_DETECTION=false
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_SAFE_ZONES=true

# Development
NODE_ENV=development
